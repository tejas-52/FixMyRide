rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isDocOwner(field) {
      return isAuthenticated() && request.auth.uid == resource.data[field];
    }

    function isNewDocOwner(field) {
      return isAuthenticated() && request.auth.uid == request.resource.data[field];
    }

    function isRecent(time) {
      return time > request.time - duration.value(1, 'm') &&
             time < request.time + duration.value(1, 'm');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'role']) &&
             data.uid is string &&
             data.name is string && data.name.size() > 0 &&
             data.role in ['USER', 'MECHANIC'];
    }

    function isValidRequest(data) {
      return data.keys().hasAll(['customerUid', 'status', 'location', 'issueType', 'vehicle']) &&
             data.customerUid is string &&
             data.status in ['PENDING', 'ACCEPTED', 'COMPLETED', 'CANCELLED'] &&
             data.location is string &&
             data.issueType is string &&
             data.vehicle is string &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt == request.time) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "tejasjagdale52@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if (isOwner(uid) || isAdmin()) && isValidUser(request.resource.data);
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && (
        (exists(resource.data) && resource.data.ownerUid == request.auth.uid) || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        (exists(resource.data) && resource.data.ownerUid == request.auth.uid) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (exists(resource.data) && resource.data.ownerUid == request.auth.uid) || 
        isAdmin()
      );
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && (
        (exists(resource.data) && resource.data.userUid == request.auth.uid) || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        (exists(resource.data) && resource.data.userUid == request.auth.uid) || 
        isAdmin()
      );
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.customerUid == request.auth.uid && isValidRequest(request.resource.data);
      allow update: if isAuthenticated() && (
        (exists(resource.data) && resource.data.customerUid == request.auth.uid) || 
        (exists(resource.data) && resource.data.mechanicUid == request.auth.uid) || 
        (exists(resource.data) && resource.data.status == 'PENDING' && request.resource.data.status == 'ACCEPTED' && request.resource.data.mechanicUid == request.auth.uid) ||
        isAdmin()
      ) && isValidRequest(request.resource.data);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
